---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Link from "../components/Link.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactSection from "../components/ContactSection.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects", ({ data }) => !data.draft);
const sortedProjects = [...projects].sort((a, b) => {
  const da = a.data.date ? new Date(a.data.date).getTime() : 0;
  const db = b.data.date ? new Date(b.data.date).getTime() : 0;
  if (db !== da) return db - da;
  return a.data.title.localeCompare(b.data.title);
});
const previewProjects = sortedProjects.slice(0, 4);
---
<BaseLayout title="Home | Personal Site" description="Welcome to my personal site">
  <Fragment slot="nav">
    <Nav />
  </Fragment>
  <!-- Main Hero (Full Height) -->
  <section class="border-b-4 flex min-h-[62svh] flex-col justify-end gap-1 pb-4 md:h-[calc(100vh-176px)] md:pb-10">
    <h1 class="text-[clamp(1.75rem,8.8vw,4.1rem)] md:text-[clamp(4rem,8vw,8rem)] uppercase leading-[0.95] text-gray-800 text-balance md:leading-tight">
      Hey there, I'm <span class="highlight-hero">David.</span><br class="hidden md:block" />
      A <span class="highlight-hero delay-1">software engineer,</span><br class="hidden md:block" />
      that <span class="highlight-hero delay-2">loves good work.</span>
    </h1>
  </section>


  <!-- About me section -->
  <div class="mt-20 max-w-7xl mx-auto">
    <h2 class="text-lg text-gray-600 uppercase tracking-wider mb-8">About Me</h2>
    <section class="my-12 grid md:grid-cols-2 gap-8 md:gap-12 items-start">
    <div>
      <h2 class="text-3xl md:text-5xl lg:text-5xl leading-tight  text-gray-800">
        Experienced Software Engineer with passion for innovation and startups
      </h2>
      <p class="mt-8 text-gray-700 text-lg">
        I'm David, an experienced software engineer with expertise in creating SaaS products, websites, and mobile applications for businesses.
      </p>
      <p class="mt-4 text-gray-700 text-lg">
        I work closely with my colleagues to deliver exceptional results that exceed expectations. If you’re looking for a dedicated software engineer to help bring your ideas to life, don’t hesitate to send me an email!
      </p>
      <div class="mt-8">
        <Link href="mailto:david@daviddelatorre.com" variant="inline" class="text-xl">
          Let's Work Together →
        </Link>
      </div>
    </div>
    <div class="relative">
      <img
        src="/img/yop.jpg"
        alt="David working at his laptop"
        class="w-full h-auto object-cover shadow-xl/30 border border-gray-300 rounded-lg"
      />
    </div>
  </section>
  </div>
  <!-- Work Showcase -->
  <div class="mt-20 max-w-7xl mx-auto">
    <h2 class="text-lg text-gray-600 uppercase tracking-wider mb-8">Recent Work</h2>
    {previewProjects.length > 0 && (
      <div class="grid md:grid-cols-2 gap-8">
        {previewProjects.map((p) => (
          <article class="border border-gray-300 p-8 md:p-10 flex flex-col rounded-lg shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-3xl md:text-4xl font-normal mb-2 text-gray-800">
              {p.data.links?.site ? (
                <Link href={p.data.links.site} class="text-gray-800">{p.data.title}</Link>
              ) : (
                p.data.title
              )}
            </h3>
            {p.data.summary && (
              <p class="text-gray-600 text-lg leading-relaxed">
                {p.data.summary}
              </p>
            )}
            {p.data.tags?.length ? (
              <div class="flex flex-wrap gap-2 mt-4 mb-auto">
                {p.data.tags.map((tag) => (
                  <span class="bg-black text-white px-3 py-1 text-xs uppercase rounded-lg">{tag}</span>
                ))}
              </div>
            ) : (
              <div class="mb-auto" />
            )}
            {p.data.links?.site && (
              <div class="mt-10">
                <Link href={p.data.links.site} variant="inline" class="text-gray-800 text-lg font-medium">
                  View project →
                </Link>
              </div>
            )}
          </article>
        ))}
      </div>
    )}
    {sortedProjects.length > 4 && (
      <div class="mt-8 text-center">
        <Link href="/work" variant="inline" class="text-xl">
          View all projects →
        </Link>
      </div>
    )}
  </div>

  <ContactSection />
  <Fragment slot="footer">
    <Footer />
  </Fragment>
</BaseLayout>
